{
  "name": "@mp-power/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "MP POWER — aplikacja mobilna (Expo): logowanie, Dziś, Workout Player, podsumowanie.",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "demo:web": "EXPO_PUBLIC_DEMO=1 expo export -p web --output-dir dist-demo"
  },
  "dependencies": {
    "@mp-power/ai": "workspace:*",
    "@mp-power/core": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "^6.0.3"
  }
}
